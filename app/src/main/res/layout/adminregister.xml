<?xml version="1.0" encoding="utf-8"?>

<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="9dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/adminRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Register"
            android:textColor="@color/textviewTextColour"
            android:gravity="center"
            android:textSize="55dp"
            android:layout_marginTop="145dp"/>

        <EditText
            android:id="@+id/adminUserNameInRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Username"
            android:textColor="@color/textviewTextColour"
            android:textColorHint="@color/textViewColour"
            android:inputType="text"
            android:layout_below="@id/adminRegister"
            android:layout_marginTop="55dp"/>


        <EditText
            android:id="@+id/adminEmailInRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your E-mail"
            android:textColor="@color/textviewTextColour"
            android:textColorHint="@color/textViewColour"
            android:inputType="textEmailAddress"
            android:layout_below="@id/adminUserNameInRegister"/>

        <EditText
            android:id="@+id/adminPasswordInRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your Password"
            android:textColor="@color/textviewTextColour"
            android:textColorHint="@color/textViewColour"
            android:inputType="textPassword"
            android:layout_below="@id/adminEmailInRegister"/>

        <EditText
            android:id="@+id/adminVillageInRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your Village"
            android:textColor="@color/textviewTextColour"
            android:textColorHint="@color/textViewColour"
            android:inputType="text"
            android:layout_below="@id/adminPasswordInRegister"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_below="@id/adminVillageInRegister">

            <Button
                android:id="@+id/adminRegisterButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register"
                android:layout_marginTop="12dp"
                android:layout_gravity="center"
                android:layout_below="@id/adminVillageInRegister"
                android:background="@drawable/buttonshape"
                android:textColor="@color/white"/>


            <TextView
                android:id="@+id/adminRegisterToLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Already Logged Please Sign In"
                android:layout_below="@id/adminRegisterButton"
                android:textColor="@color/textviewTextColour"
                android:gravity="center"
                android:textSize="22dp"
                android:layout_marginTop="125dp"/>

        </LinearLayout>


    </RelativeLayout>

</LinearLayout>



